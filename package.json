{
  "name": "tasklist-board",
  "version": "0.1.1",
  "description": "Status-grouped task list plugin for Obsidian.",
  "main": "main.js",
  "type": "module",
  "packageManager": "pnpm@12.3.4",
  "engines": {
    "pnpm": ">=9"
  },
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit --skipLibCheck",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck",
    "build": "pnpm typecheck && node esbuild.config.mjs production",
    "version": "node version-bump.mjs && git add manifest.json versions.json"
  },
  "keywords": [
    "obsidian",
    "plugin",
    "tasks"
  ],
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^24.13.3",
    "builtin-modules": "^5.3.0",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.5",
    "eslint-plugin-obsidianmd": "~0.4.1",
    "obsidian": "1.13.1",
    "prettier": "^3.9.6",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.67.0"
  }
}
